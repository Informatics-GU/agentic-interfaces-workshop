{
  "$id": "https://example.edu/a2ui/study-planner/v1/catalog.json",
  "catalogId": "https://example.edu/a2ui/study-planner/v1/catalog.json",
  "components": {
    "WeekSchedule": {
      "type": "object",
      "description": "Root component for a student's generated seven-day schedule.",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "children": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "children"],
      "additionalProperties": false
    },
    "DayColumn": {
      "type": "object",
      "description": "A single weekday/day column containing scheduled study blocks.",
      "properties": {
        "day": { "type": "string" },
        "date": { "type": "string" },
        "children": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["day", "children"],
      "additionalProperties": false
    },
    "StudyBlock": {
      "type": "object",
      "description": "One scheduled work session for an assignment.",
      "properties": {
        "course": { "type": "string" },
        "assignment": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "minutes": { "type": "integer", "minimum": 5 },
        "due": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "note": { "type": "string" }
      },
      "required": ["assignment", "start", "end", "minutes", "due", "priority"],
      "additionalProperties": false
    },
    "DeadlineBadge": {
      "type": "object",
      "description": "Highlights a deadline that should remain visible in the weekly plan.",
      "properties": {
        "label": { "type": "string" },
        "due": { "type": "string" },
        "urgency": { "type": "string", "enum": ["normal", "soon", "urgent"] }
      },
      "required": ["label", "due", "urgency"],
      "additionalProperties": false
    },
    "ScheduleSummary": {
      "type": "object",
      "description": "Short summary of the planning strategy and total scheduled workload.",
      "properties": {
        "text": { "type": "string" },
        "totalMinutes": { "type": "integer", "minimum": 0 }
      },
      "required": ["text", "totalMinutes"],
      "additionalProperties": false
    },
    "WarningBanner": {
      "type": "object",
      "description": "Used only when workload cannot fit safely before due dates or information is missing.",
      "properties": {
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] }
      },
      "required": ["message", "severity"],
      "additionalProperties": false
    }
  },
  "functions": [],
  "theme": {}
}
